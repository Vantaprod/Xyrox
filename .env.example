# ============================================================
# Xyrox — Environment Configuration Template
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to Git.
# ============================================================

# Database
DATABASE_URL=sqlite:///./data/app.db

# AI Provider
AI_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=llama3

# Security
SECRET_KEY=replace_with_a_real_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Timezone
TZ=Africa/Lagos